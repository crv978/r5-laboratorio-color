    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
